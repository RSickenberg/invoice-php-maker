{
    "name": "rsickenberg/invoice-php-maker",
    "description": "CLI tool to generate Swiss qr bills.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/console": "^8.1",
        "tecnickcom/tc-lib-pdf": "^8.20",
        "sprain/swiss-qr-bill": "dev-master",
        "nesbot/carbon": "^3.14"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "RSickenberg\\InvoicePhpMaker\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": "@php bin/build-fonts.php",
        "post-update-cmd": "@php bin/build-fonts.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RSickenberg/php-swiss-qr-bill"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
